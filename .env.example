# Copy to .env (or set in your shell). Values here are never committed.
# Secrets come from the environment, not config.json; config.json never holds
# values you don't want on disk.

# Shopify Admin API (custom app)
GEO_STORE_DOMAIN=your-store.myshopify.com
GEO_ADMIN_API_TOKEN=shpat_...
# Latest stable as of Oct 2026: 2026-10 (2025-10 and older are unsupported).
# Re-check shopify.dev/docs/api/versioning before going live.
GEO_API_VERSION=2026-10

# Tracking providers (leave empty to skip a provider; official APIs only)
GEO_OPENAI_API_KEY=
GEO_PERPLEXITY_API_KEY=
GEO_GEMINI_API_KEY=
GEO_ANTHROPIC_API_KEY=

# Storage (default: SQLite file next to the repo)
# DATABASE_URL=sqlite:///geo_agent.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/geo

# Server binding (default loopback-only)
GEO_HOST=127.0.0.1
GEO_PORT=8000

# Optional dashboard password (empty = no auth). Set in Phase 7.
GEO_DASHBOARD_PASSWORD=
